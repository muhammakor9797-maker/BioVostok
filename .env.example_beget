# === Продакшен: Beget ===
# Скопируйте этот файл в .env на сервере и заполните значения.
# Файл .env в git не попадает (см. .gitignore) — не коммитьте его!

# Секретный ключ Django (уникальный для продакшена!):
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# На проде DEBUG=False
DEBUG=False
ALLOWED_HOSTS=biovostok.shop,www.biovostok.shop
CSRF_TRUSTED_ORIGINS=https://biovostok.shop,https://www.biovostok.shop

# MySQL — создать в панели Beget → Базы данных → MySQL
DATABASE_URL=mysql://логин_бд:пароль_бд@localhost:3306/имя_бд?charset=utf8

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram — уведомления о заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта (для Gmail — пароль приложения)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=
ORDERS_EMAIL=

# Пароли суперпользователей, создаются scripts/create_superuser.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN2_USERNAME=
ADMIN2_PASSWORD=
ADMIN2_EMAIL=

# Сразу после выпуска SSL-сертификата можно оставить True.
# Если сертификат ещё не выпущен — поставьте False, иначе будет редирект-петля.
SECURE_SSL_REDIRECT=True
