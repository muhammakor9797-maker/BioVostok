# === Переменные окружения для BioVostok (DADA Cloud / локальная разработка) ===
# Скопируйте этот файл в .env и заполните значения

# Секретный ключ Django (обязательно, без него приложение не запустится)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Режим отладки: True только для локальной разработки, на продакшене — False
DEBUG=False

# Разрешенные хосты (через запятую). Для DADA Cloud укажите домен приложения.
ALLOWED_HOSTS=localhost,127.0.0.1

# Доверенные источники CSRF (через запятую, с https://).
# Для DADA Cloud укажите https://<ваш-домен-dada-cloud>
CSRF_TRUSTED_ORIGINS=

# База данных: пусто = SQLite (локальная разработка).
# Для DADA Cloud PostgreSQL: postgres://user:password@host:port/dbname
DATABASE_URL=

# Cloudinary (хранение изображений товаров)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram — уведомления о заказах (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта (опционально). Для Gmail используется пароль приложения:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=
ORDERS_EMAIL=

# Каталог персистентных данных (для DADA Cloud, если предоставляется volume)
DATA_DIR=/data

# Для создания суперпользователя при деплое (опционально)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Редирект HTTP → HTTPS (включить после выпуска SSL-сертификата)
SECURE_SSL_REDIRECT=True
