# === Локальная разработка ===
# Скопируйте этот файл в .env и заполните значения

# Секретный ключ Django (сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=
# Включать только для локальной разработки!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных: пусто = SQLite. Пример для MySQL:
# mysql://user:password@localhost:3306/dbname?charset=utf8
DATABASE_URL=

# Cloudinary (хранение изображений товаров)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram — уведомления о заказах (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта (опционально). Для Gmail используется пароль приложения:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=
ORDERS_EMAIL=
